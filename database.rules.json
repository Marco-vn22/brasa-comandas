{
  "rules": {
    ".read": false,
    ".write": false,
    "staff": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false } },
    "orders": {
      ".read": "auth != null && root.child('staff').child(auth.uid).val() === true",
      ".indexOn": ["createdAt", "delivered"],
      "$id": {
        ".write": "auth != null && root.child('staff').child(auth.uid).val() === true && newData.exists()",
        ".validate": "newData.hasChildren(['id','code','createdAt','type','method','total','received','items','delivered']) && (!data.exists() || data.child('delivered').val() !== true) && (newData.child('type').val() === 'table' ? newData.child('table').isString() && newData.child('table').val().length > 0 : newData.child('name').isString() && newData.child('name').val().length > 0)",
        "id": { ".validate": "newData.val() === $id" },
        "code": { ".validate": "newData.isString() && newData.val().length <= 10 && (!data.exists() || newData.val() === data.val())" },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() ? newData.val() <= now + 60000 && newData.val() >= now - 300000 : newData.val() === data.val())" },
        "type": { ".validate": "(newData.val() === 'table' || newData.val() === 'takeaway') && (!data.exists() || newData.val() === data.val())" },
        "table": { ".validate": "newData.isString() && newData.val().length <= 10 && (!data.exists() || newData.val() === data.val())" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 60 && (!data.exists() || newData.val() === data.val())" },
        "notes": { ".validate": "newData.isString() && newData.val().length <= 300 && (!data.exists() || newData.val() === data.val())" },
        "method": { ".validate": "(newData.val() === 'cash' || newData.val() === 'yape') && (!data.exists() || newData.val() === data.val())" },
        "total": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() % 1 === 0 && (!data.exists() || newData.val() === data.val())" },
        "received": { ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('total').val() && newData.val() % 1 === 0 && (!data.exists() || newData.val() === data.val())" },
        "delivered": { ".validate": "newData.isBoolean() && (data.exists() || newData.val() === false)" },
        "deliveredAt": { ".validate": "newData.isNumber() && newData.parent().child('delivered').val() === true && newData.val() <= now + 60000" },
        "items": {
          ".validate": "newData.hasChildren()",
          "$item": {
            ".validate": "newData.hasChildren(['id','name','price','qty','state']) && (!data.parent().exists() || data.exists()) && (newData.parent().parent().child('delivered').val() !== true || newData.child('state').val() === 'ready')",
            "id": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 100 && (!data.exists() || newData.val() === data.val())" },
            "price": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() % 1 === 0 && (!data.exists() || newData.val() === data.val())" },
            "qty": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() % 1 === 0 && (!data.exists() || newData.val() === data.val())" },
            "state": { ".validate": "(!data.exists() && newData.val() === 'pending') || (data.exists() && (newData.val() === data.val() || (data.val() === 'pending' && newData.val() === 'preparing') || (data.val() === 'preparing' && newData.val() === 'ready')))" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
